{
  "name": "the-walking-dead-procedural",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "blockout:build": "tsx scripts/build-blockout.ts",
    "blockout:check": "tsx scripts/build-blockout.ts --check",
    "footprints": "tsx scripts/build-footprints.ts",
    "resources:list": "tsx scripts/build-resource-list.ts",
    "motion:mask": "tsx scripts/build-motion-mask.ts",
    "textures:modules": "tsx scripts/build-module-textures.ts",
    "textures:mobile": "tsx scripts/build-mobile-textures.ts",
    "textures:clouds": "tsx scripts/build-cloud-noise.ts",
    "assets:optimize": "tsx scripts/optimize-assets.ts",
    "assets": "tsx scripts/build-assets.ts && tsx scripts/build-vegetation.ts",
    "assets:vegetation": "tsx scripts/build-vegetation.ts",
    "assets:check": "tsx scripts/build-vegetation.ts --geometry-only",
    "backup": "python3 scripts/package-game.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "meshoptimizer": "1.3.0",
    "next": "16.3.3",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "postcss": "^8.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three-mesh-bvh": "^0.9.15",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
